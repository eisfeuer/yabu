
-- YABU -- yet another bridge util
-- v1.1

local record Yabu

    ------------------------
    -- Main bridge object --
    ------------------------

    -- bridge with injections
    record Bridge
        params: BridgeParams
        injections: Injections
    end

    -- makes the main bridge struct
    -- @param params Params you will get from the updateFn
    -- @param injections Railing, Pillar and Abutment injection functions
    makeBridgeFromParams: function(params: BridgeParams, injections: Injections): Bridge

    -- builds the output models you have to return in the bridge updateFn
    -- @param bridge struct generated by makeBridgeFromParams
    -- @return List of models which is the return value of the updateFn
    getResultModels: function(bridge: Bridge): BridgeModelList

    ------------------
    -- Input params --
    ------------------

    -- a street / track on the bridge (multiple tracks are multiple lanes)
    record Lane
        offset: number
        type: integer
    end

    -- railing interval attributes as param given from the game engine
    record RailingIntervalParams
        curvature: number
        hasPillar: {integer, integer}
        lanes: {Lane}
        length: number
    end

    -- bridge attributes as params given from the game engine
    record BridgeParams
        pillarHeights: { number }
        pillarWidth: number
        pillarLength: number
        railingWidth: number
        railingIntervals: {RailingIntervalParams}
        hasAbutment: {boolean, boolean}
        abutmentHeight: {number, number}
        beginNeedEntry: boolean
        endNeedEntry: boolean
    end

    -------------------------
    -- Injection functions --
    -------------------------

    -- injections input
    record Injections
        railing: RailingInjection -- injection function for railing/deck section
        pillar: PillarInjection -- injection function for pillar
        abutment: AbutmentInjection | nil -- injection function for abutment (nil if bridge has no abutments)
    end

    record RailingInterval
        intervalIndex: integer -- index of the interval
        curvature: number -- curvature
        hasPillar: {integer, integer} -- pillar indices of the prepending appending pillar
        lanes: {Lane} -- lanes on the bridge
        length: number -- total length of the bridge (or bridge section)
        width: number -- with of the street/tracks
        beginNeedEntry: boolean -- section has prepending abutment
        endNeedEntry: boolean -- section has appending abutment
    end

    -- injection function for the railing/deck section
    -- @param BridgeParams original bridge params
    -- @param RailingInterval affected railing interval
    -- @return a list of models of the railing/deck section
    type RailingInjection = function(BridgeParams, RailingInterval): RailingSectionModel

    -- Param from the pillar injection function
    record Pillar
        pillarIndex: integer -- index of the pillar
        height: number -- height
        length: number -- length (from bridge config)
        width: number -- width (from bridge config)
    end

    -- injection functon for the pillar
    -- @param BridgeParams original bridge params
    -- @param Pillar affected pillar
    -- @return a list of models of the pillar
    type PillarInjection = function(BridgeParams, Pillar): PillarModel

    -- Param from the abutment injection function
    record Abutment
        abutmentIndex: integer -- 1 for start; 2 for end
        height: number -- abutment height
    end

    -- injection function for the abutment
    -- @param BridgeParams original bridge params
    -- @param Abutment affected abutment
    -- @return a list of models of the abutment
    type AbutmentInjection = function(BridgeParams, Abutment): PillarModel

    ---------------------------------------------------------------------------------------
    -- Input param types and interfaces used for main function in the injection function --
    ---------------------------------------------------------------------------------------

    -- input to the abutment building file main function input param
    interface AbutmentParamsInterface
        repo: PartModelRepository -- given part model repository
        bridge: BridgeParams -- original bridge params
        abutment: Abutment -- abutment param given from the injection function
    end

    -- interface of the abutment building file
    interface AbutmentInterface
        -- builds an abutment and returns the model list
        -- @param input (see AbutmentParamsInterface above)
        -- @return a list of part models for the abutment
        buildAndGetAbutmentModel: function(AbutmentParamsInterface): PillarModel
    end

    -- input to the pillar building file main function input param
    interface PillarParamsInterface
        repo: PartModelRepository -- given part model repository
        bridge: BridgeParams -- original bridge params
        pillar: Pillar -- pillar param given from the injection function
    end

    -- interface of the pillar building file
    interface PillarInterface
        -- builds a pillar and returns the model list
        -- @param input (see PillarParamsInterface above)
        -- @return a list of part models for the pillar
        buildAndGetPillarModel: function(PillarParamsInterface): PillarModel
    end

    -- input to the railing/deck section file main function input param
    interface RailingParamsInterface
        repo: PartModelRepository -- given part model repository
        bridge: BridgeParams -- original bridge params
        interval: RailingInterval -- railing interval param from the injection function
    end

    -- interface for the railing/deck section building file
    interface RailingInterface
        -- builds a railing section and returns the model list
        -- @param input (see RailingParamsInterface above)
        -- @return A list of all part models for the railing section
        buildAndGetRailingSectionModel: function(RailingParamsInterface): RailingSectionModel
    end

    ------------------
    -- Result types --
    ------------------

    -- end result which has to return in updateFn
    record BridgeModelList
        railingModels: RailingModelList -- Railing parts
        pillarModels: PillarModelList -- Pillar and abutment parts
    end

    -- hierarchy of the railing model types
    -- - RailingModelList
    -- --- RailingSectionModel
    -- ----- RailingRowModel

    -- set of models in as slice of a railing section
    type RailingRowModel = {Model}
    -- railing section as a list of railing slices
    type RailingSectionModel = {RailingRowModel}
    -- complete railing/deck
    type RailingModelList = {RailingSectionModel}

    -- hierarchy of the pillar/abutment model types
    -- - PillarModelList
    -- --- PillarModel
    -- ----- PillarRowModel

     -- set of models in a slice of a pillar
    type PillarRowModel = {Model}
    -- pillar as a list of slices
    type PillarModel = {PillarRowModel}
    -- all pillars / abutments of a bridge
    type PillarModelList = {PillarModel}

    ---------------------------
    -- Part Model Repository --
    ---------------------------

    -- Bounding box of a part model
    type BoundingBox = {
        {number, number, number}, -- min {x, y, z}
        {number, number, number} -- max {x, y, z}
    }

    -- a Part model element of reposition. Has the full model id (e.g. /infrastructure/bridge/my_bridge/pillar_rep_side.mdl) and the bounding box
    record PartModel 
        id: string -- full model id (see descripton above)
        bb: BoundingBox -- bounding box (see definition above)
    end

    -- Part model repository to manage part models with their bounding boxes
    record PartModelRepository
        modelPath: string -- path to the .mdl files (e.g. /infrastructure/bridge/my_bridge/)
        partModels: {string:PartModel} -- map to access a part model by given key
    end

    -- initializes the part model repository (you can send it via config params from the .bridge.lua to the .script.lua)
    -- @param modelPath root path of the .mdl files from the bridge parts
    -- @return initialized model repository 
    initializeModelPartRepository: function(modelPath: string): Yabu.PartModelRepository

    -- set up the part model repository, adds simple access to the bounding boxes and ids, has to be done in the .script.lua file (not in the .bridge.lua file)
    -- @param repo initialized part model repository
    -- @pre part model repository has to been initialized
    -- @pre has to be done in the .script.lua updateFn
    setupModelPartRepository: function(repo: PartModelRepository): PartModelRepository

    -- adds a part model to the repository
    -- @param repo the repository to add a part model
    -- @param partModelId ModelId / filename of the part model (e.g. pillar_rep_side.mdl)
    -- @param options additional options: key: custom part model key (use if key cannot be made from the file name)
    addPartModel: function(repo: PartModelRepository, partModelId: string, bb: BoundingBox, options: {string:any} | nil)

    -- utility function
    -- you can mirror the bounding box along the y axis. This is usable, when you have e.g. a mirrored railing part at the opposite side of your bridge
    -- @params bb bounding box to mirror
    -- @return mirrored bounding box
    mirrorBbY: function(bb: BoundingBox): BoundingBox

    -----------------------
    -- utility functions --
    -----------------------

    --- Size calculation

    -- row size calculation result
    record RowSizeCalculationResult
        amountOfRows: integer -- amount of rows to archive total size
        rowLength: number -- length of a row/part (scaled)
        rowScale: number -- scale which has to be applied to a row element
        totalLength: number -- total length
    end

    -- typical row calculation results needed for pillars or abutments 
    record PillarRowData
        y: RowSizeCalculationResult -- horizontal results
        z: RowSizeCalculationResult -- vertical results
    end

    -- typical row calculation results needed for railing intervals
    record RailingRowData
        x: RowSizeCalculationResult -- x results
        y: RowSizeCalculationResult -- y results
    end

    -- calculate the amount of rows to archive the row length, the length and scale of a part. Can be used for x, y and z directions
    -- @param totalLength length of a segment you want to slice (e.g. a railing segment, a pillar, a slice of the deck)
    -- @param bestSliceLength Length of a row you want to be near to. (Normally the bounding box lenth of you part model)
    -- @param options additional options: keepScale: forces scale to been 1; fixedAmountOfRows forces the amount of rows to a scpecific value (length may not be close to the bestSliceLength)
    -- @return amountOfRows: Amount of rows/parts needed to archive the total length; length of a row element (scaled); scale which has to be applied to the row element; totalLength total length
    calculateOptimalRowSize: function(totalLength: number, bestSliceLength: number, options: {string:any} | nil): RowSizeCalculationResult

    ---- Railing utilities

    -- checks whether a railing segment has a pillar at the start position
    -- @param interval affected railing interval
    -- @return true if there is a prepending pillar
    hasPrependingPillar: function(interval: Yabu.RailingInterval): boolean

    -- checks whether a railing segment has a pillar at the end position
    -- @param interval affected railing interval
    -- @return true if there is a appending pillar
    hasAppendingPillar: function(interval: Yabu.RailingInterval): boolean

    -- returns the pillar at the start of an interval
    -- @param bridge affected bridge
    -- @param interval affected interval
    -- return pillar at the start of an interval (nil if it not exists)
    getPrependingPillar: function(bridge: Yabu.BridgeParams, interval: Yabu.RailingInterval): Yabu.Pillar

    -- returns the pillar at the end of an interval
    -- @param bridge affected bridge
    -- @param interval affected interval
    -- return pillar at the end of an interval (nil if it not exists)
    getAppendingPillar: function(bridge: Yabu.BridgeParams, interval: Yabu.RailingInterval): Yabu.Pillar

    -- checks whether a collition is on the left side of the bridge (means there is a switch or intersection)
    -- @param interval affected railing interval
    -- @return true if there is a collistion on the left side
    isCollidingLeft: function(interval: Yabu.RailingInterval): boolean

    -- checks whether a collition is on the right side of the bridge (means there is a switch or intersection)
    -- @param interval affected railing interval
    -- @return true if there is a collistion on the right side
    isCollidingRight: function(interval: Yabu.RailingInterval): boolean

    -- calculates the average lane offset (that is normally the offset the bridge has to been moved in y position)
    -- @param interval affected railing interval
    -- @return average lane offset
    getAvgLaneOffset: function(interval: RailingInterval): number

    -- Merging Models

    -- merges multiple railing section models to one
    -- @params railing section models to merge
    -- @return merged railing section model
    getMergedRailingSectionModel: function(models: {RailingSectionModel}): RailingSectionModel

    -- merges multiple pillar models to one
    -- @params pillar models to merge
    -- @return merged pillar model
    getMergedPillarModel: function(models: {PillarModel}): PillarModel
end

return Yabu