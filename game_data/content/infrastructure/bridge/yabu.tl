local yabu: Yabu = {}

-- Number naming for better readability

local X: integer = 1
local Y: integer = 2
local Z: integer = 3

local COLLISION_LEFT: integer = 1
local COLLISION_RIGHT: integer = 2
local COLLISION_BOTH: integer = 3

local START: integer = 1
local END: integer = 2

local function optional(value: {string: any} | nil): {string: any}
    return value or {}
end

-------------------------------------------
-- main bridge definition and management --
-------------------------------------------

-- makes the main bridge struct
-- @param params Params you will get from the updateFn
-- @param injections Railing, Pillar and Abutment injection functions
function yabu.makeBridgeFromParams(params: Yabu.BridgeParams, injections: Yabu.Injections): Yabu.Bridge
    return {
        params = params,
        injections = injections
    }
end

-- builds the output models you have to return in the bridge updateFn
-- @param bridge struct generated by makeBridgeFromParams
-- @return List of models which is the return value of the updateFn
function yabu.getResultModels(bridge: Yabu.Bridge): Yabu.BridgeModelList
    -- add railing models
    local railingModels: Yabu.RailingModelList = {}
    for intervalIndex, railingInterval in ipairs(bridge.params.railingIntervals) do
        table.insert(railingModels, bridge.injections.railing(bridge.params, {
            intervalIndex = intervalIndex - 1,
            curvature = railingInterval.curvature,
            hasPillar = railingInterval.hasPillar,
            lanes = railingInterval.lanes,
            length = railingInterval.length,
            width = bridge.params.railingWidth,
            beginNeedEntry = bridge.params.beginNeedEntry and intervalIndex == 1,
            endNeedEntry = bridge.params.endNeedEntry and intervalIndex == #bridge.params.railingIntervals
        }))
    end

    local pillarModels: Yabu.PillarModelList = {}
    
    -- add pillars
    for pillarIndex, pillar in ipairs(bridge.params.pillarHeights) do
        table.insert(pillarModels, bridge.injections.pillar(bridge.params, {
            pillarIndex = pillarIndex - 1,
            height = pillar,
            length = bridge.params.pillarLength,
            width = bridge.params.pillarWidth
        }))
    end
    -- add abutments
    if bridge.injections.abutment and bridge.params.hasAbutment[START] then
        local startAbutment: Yabu.Abutment = bridge.params.hasAbutment[START] and {
            abutmentIndex = START,
            height = bridge.params.abutmentHeight[START]
        }
        table.insert(pillarModels, (bridge.injections.abutment as Yabu.AbutmentInjection)(bridge.params, startAbutment))
    end
    if bridge.injections.abutment and bridge.params.hasAbutment[END] then
        local endAbutment: Yabu.Abutment = bridge.params.hasAbutment[END] and {
            abutmentIndex = END,
            height = bridge.params.abutmentHeight[END]
        }
        table.insert(pillarModels, (bridge.injections.abutment as Yabu.AbutmentInjection)(bridge.params, endAbutment))
    end

    return {
        pillarModels = pillarModels,
        railingModels = railingModels
    }
end

-----------------------------
-- Bridge model repository --
-----------------------------

local BoundingBox_mt: metatable<yabu.BoundingBox> = {
    __index = function(bb: yabu.BoundingBox, key: string): Vec3Util.Vec3
        local MIN: integer = 1
        local MAX: integer = 2

        if key == "min" then
            return { x = bb[MIN][X], y = bb[MIN][Y], z = bb[MIN][Z] }
        end
        if key == "max" then
            return { x = bb[MAX][X], y = bb[MAX][Y], z = bb[MAX][Z] }
        end
        if key == "size" then
            return {
                x = bb[MAX][X] - bb[MIN][X],
                y = bb[MAX][Y] - bb[MIN][Y],
                z = bb[MAX][Z] - bb[MIN][Z]
            }
        end

        return nil
    end
}

local PartModelRepository_mt: metatable<Yabu.PartModelRepository> = {
    __index = function(repository: Yabu.PartModelRepository, key: string): Yabu.PartModel | nil
        return repository.partModels[key as string]
    end
}

-- initializes the part model repository (you can send it via config params from the .bridge.lua to the .script.lua)
-- @param modelPath root path of the .mdl files from the bridge parts
-- @return initialized model repository 
function yabu.initializeModelPartRepository(modelPath: string): Yabu.PartModelRepository
    local repo: Yabu.PartModelRepository =  {
        modelPath = modelPath,
        partModels = {}
    }
    return setmetatable(repo, PartModelRepository_mt)
end

-- set up the part model repository, adds simple access to the bounding boxes and ids, has to be done in the .script.lua file (not in the .bridge.lua file)
-- @param repo initialized part model repository
-- @pre part model repository has to been initialized
-- @pre has to be done in the .script.lua updateFn
function yabu.setupModelPartRepository(repo: Yabu.PartModelRepository): Yabu.PartModelRepository
    for _, part in pairs(repo.partModels) do
        setmetatable(part.bb, BoundingBox_mt)
    end
    return setmetatable(repo, PartModelRepository_mt)
end

-- internal function
-- creates a part model key from the file (e.g. pillarRepSide from pillar_rep_side.mdl)
-- @param partModelId model id (e.g. pillar_rep_side.mdl)
-- @return partModelKey (e.g. pillarRepSide)
local function makePartModelKey(partModelId: string): string
    local key: string = string.gsub(partModelId, ".mdl$", "")
    key = string.gsub(key, "[-_ %s]+(.)", string.upper)
    key = string.gsub(key, "^(.)", string.lower)
    key = string.gsub(key, "[-_ %s]+", "")
    
    return key
end

-- adds a part model to the repository
-- @param repo the repository to add a part model
-- @param partModelId ModelId / filename of the part model (e.g. pillar_rep_side.mdl)
function yabu.addPartModel(repo: yabu.PartModelRepository, partModelId: string, bb: yabu.BoundingBox, options: {string:any} | nil)
    local key:string = optional(options).key as string or makePartModelKey(partModelId)
    repo.partModels[key] = {
        id = repo.modelPath  .. partModelId,
        bb = bb
    }
end

-- utility function
-- you can mirror the bounding box along the y axis. This is usable, when you have e.g. a mirrored railing part at the opposite side of your bridge
-- @params bb bounding box to mirror
-- @return mirrored bounding box
function yabu.mirrorBbY(bb: yabu.BoundingBox): yabu.BoundingBox
    local MIN: integer = 1
    local MAX: integer = 2

    return { {bb[MIN][X], -bb[MAX][Y], bb[MIN][Z]}, {bb[MAX][X], bb[MIN][Y], bb[MAX][Z]} }
end

-----------------------
-- General Utilities --
-----------------------

-- calculate the amount of rows to archive the row length, the length and scale of a part. Can be used for x, y and z directions
-- @param totalLength length of a segment you want to slice (e.g. a railing segment, a pillar, a slice of the deck)
-- @param bestSliceLength Length of a row you want to be near to. (Normally the bounding box lenth of you part model)
-- @param options additional options: keepScale: forces scale to been 1; fixedAmountOfRows forces the amount of rows to a scpecific value (length may not be close to the bestSliceLength)
-- @return amountOfRows: Amount of rows/parts needed to archive the total length; length of a row element (scaled); scale which has to be applied to the row element; totalLength total length
function yabu.calculateOptimalRowSize(totalLength: number, bestSliceLength: number, options: {string:any} | nil): yabu.RowSizeCalculationResult
    if (totalLength <= 0 or bestSliceLength <= 0) then
        return {
            amountOfRows = 0,
            rowLength = 0,
            rowScale = 1,
            totalLength = totalLength
        }
    end

    if optional(options).keepScale then
        local amountOfRows = optional(options).fixedAmountOfRows as integer or math.ceil(totalLength / bestSliceLength)
        return {
            amountOfRows = amountOfRows,
            rowLength = bestSliceLength,
            rowScale = 1,
            totalLength = amountOfRows * bestSliceLength,
        }
    end


    local amountOfSlices: integer = optional(options).fixedAmountOfRows as integer or math.floor(totalLength / bestSliceLength + 0.5)
    if amountOfSlices == 0 then
        amountOfSlices = 1
    end
    local sliceLength: number = totalLength / amountOfSlices
    local sliceScale: number = sliceLength / bestSliceLength

    return {
        amountOfRows = amountOfSlices,
        rowLength = sliceLength,
        rowScale = sliceScale,
        totalLength = totalLength,
    }
end

-- Railing utilities


-- checks whether a railing segment has a pillar at the start position
-- @param interval affected railing interval
-- @return true if there is a prepending pillar
function yabu.hasPrependingPillar(interval: Yabu.RailingInterval): boolean
    if interval.beginNeedEntry then
        return false
    end

    return interval.hasPillar[START] >= 0
end

-- checks whether a railing segment has a pillar at the end position
-- @param interval affected railing interval
-- @return true if there is a appending pillar
function yabu.hasAppendingPillar(interval: Yabu.RailingInterval): boolean
    if interval.endNeedEntry then
        return false
    end

    return interval.hasPillar[END] >= 0
end

-- returns the pillar at the start of an interval
-- @param bridge affected bridge
-- @param interval affected interval
-- return pillar at the start of an interval (nil if it not exists)
function yabu.getPrependingPillar(bridge: Yabu.BridgeParams, interval: Yabu.RailingInterval): Yabu.Pillar
    if not yabu.hasPrependingPillar(interval) then
        return nil
    end

    local pillarHeight = bridge.pillarHeights[interval.hasPillar[START] + 1]
    return {
        pillarIndex = interval.hasPillar[START],
        height = pillarHeight,
        length = bridge.pillarLength,
        width = bridge.railingWidth
    }
end

-- returns the pillar at the end of an interval
-- @param bridge affected bridge
-- @param interval affected interval
-- return pillar at the end of an interval (nil if it not exists)
function yabu.getAppendingPillar(bridge: Yabu.BridgeParams, interval: Yabu.RailingInterval): Yabu.Pillar
    if not yabu.hasAppendingPillar(interval) then
        return nil
    end

    local pillarHeight = bridge.pillarHeights[interval.hasPillar[END] + 1]
    return {
        pillarIndex = interval.hasPillar[END],
        height = pillarHeight,
        length = bridge.pillarLength,
        width = bridge.railingWidth
    }
end

-- checks whether a collition is on the left side of the bridge (means there is a switch or intersection)
-- @param interval affected railing interval
-- @return true if there is a collistion on the left side
function yabu.isCollidingLeft(interval: Yabu.RailingInterval): boolean
    if not interval.lanes or #interval.lanes == 0 then
        return false
    end

    local leftOuterLaneType: integer = interval.lanes[#interval.lanes].type
    return leftOuterLaneType == COLLISION_LEFT or leftOuterLaneType == COLLISION_BOTH
end

-- checks whether a collition is on the right side of the bridge (means there is a switch or intersection)
-- @param interval affected railing interval
-- @return true if there is a collistion on the right side
function yabu.isCollidingRight(interval: Yabu.RailingInterval): boolean
    if not interval.lanes or #interval.lanes == 0 then
        return false
    end

    local rightOuterLaneType: integer = interval.lanes[1].type
    return rightOuterLaneType == COLLISION_RIGHT or rightOuterLaneType == COLLISION_BOTH
end

-- calculates the average lane offset (that is normally the offset the bridge has to been moved in y position)
-- @param interval affected railing interval
-- @return average lane offset
function yabu.getAvgLaneOffset(interval: Yabu.RailingInterval): number
    if not interval.lanes or #interval.lanes == 0 then
        return 0
    end

    local sum: number = 0
    for _, lane in ipairs(interval.lanes) do
        sum = sum + lane.offset
    end
    return sum / (#interval.lanes + 0.0)
end

-- merges multiple railing section models to one
-- @params railing section models to merge
-- @return merged railing section model
function yabu.getMergedRailingSectionModel(models: {Yabu.RailingSectionModel}): Yabu.RailingSectionModel
    local mergedModel: Yabu.RailingSectionModel = {}

    for _, railingSectionModel in ipairs(models or {}) do        
        for i, rowModel in ipairs(railingSectionModel) do
            mergedModel[i] = mergedModel[i] or {}
            for _, model in ipairs(rowModel) do
                table.insert(mergedModel[i], model)
            end
        end
    end

    return mergedModel
end

-- merges multiple pillar models to one
-- @params pillar models to merge
-- @return merged pillar model
function yabu.getMergedPillarModel(models: {Yabu.PillarModel}): Yabu.PillarModel
    local mergedModel: Yabu.PillarModel = {}

    for _, pillarModel in ipairs(models or {}) do        
        for i, rowModel in ipairs(pillarModel) do
            mergedModel[i] = mergedModel[i] or {}
            for _, model in ipairs(rowModel) do
                table.insert(mergedModel[i], model)
            end
        end
    end

    return mergedModel
end

return yabu